{
  "name": "@m14n/devkit",
  "description": "Shared developer toolkit with ESLint, Prettier, Commitlint, TypeScript, lint-staged and semantic-release configs for consistent project setup.",
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslint-config",
    "prettier",
    "prettier-config",
    "commitlint",
    "commitlint-config",
    "typescript",
    "tsconfig",
    "devkit",
    "linting",
    "code-style",
    "config"
  ],
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/eslint-base.d.ts",
        "default": "./dist/eslint-base.js"
      },
      "require": {
        "types": "./dist/eslint-base.d.cts",
        "default": "./dist/eslint-base.cjs"
      }
    },
    "./commitlint": {
      "import": {
        "types": "./dist/commitlint.d.ts",
        "default": "./dist/commitlint.js"
      },
      "require": {
        "types": "./dist/commitlint.d.cts",
        "default": "./dist/commitlint.cjs"
      }
    },
    "./eslint": {
      "import": {
        "types": "./dist/eslint-base.d.ts",
        "default": "./dist/eslint-base.js"
      },
      "require": {
        "types": "./dist/eslint-base.d.cts",
        "default": "./dist/eslint-base.cjs"
      }
    },
    "./eslint-base": {
      "import": {
        "types": "./dist/eslint-base.d.ts",
        "default": "./dist/eslint-base.js"
      },
      "require": {
        "types": "./dist/eslint-base.d.cts",
        "default": "./dist/eslint-base.cjs"
      }
    },
    "./eslint-browser": {
      "import": {
        "types": "./dist/eslint-browser.d.ts",
        "default": "./dist/eslint-browser.js"
      },
      "require": {
        "types": "./dist/eslint-browser.d.cts",
        "default": "./dist/eslint-browser.cjs"
      }
    },
    "./eslint-node": {
      "import": {
        "types": "./dist/eslint-node.d.ts",
        "default": "./dist/eslint-node.js"
      },
      "require": {
        "types": "./dist/eslint-node.d.cts",
        "default": "./dist/eslint-node.cjs"
      }
    },
    "./eslint-react": {
      "import": {
        "types": "./dist/eslint-react.d.ts",
        "default": "./dist/eslint-react.js"
      }
    },
    "./eslint-tsdoc": {
      "import": {
        "types": "./dist/eslint-tsdoc.d.ts",
        "default": "./dist/eslint-tsdoc.js"
      },
      "require": {
        "types": "./dist/eslint-tsdoc.d.cts",
        "default": "./dist/eslint-tsdoc.cjs"
      }
    },
    "./eslint-vitest": {
      "import": {
        "types": "./dist/eslint-vitest.d.ts",
        "default": "./dist/eslint-vitest.js"
      },
      "require": {
        "types": "./dist/eslint-vitest.d.cts",
        "default": "./dist/eslint-vitest.cjs"
      }
    },
    "./lint-staged": {
      "import": {
        "types": "./dist/lint-staged.d.ts",
        "default": "./dist/lint-staged.js"
      },
      "require": {
        "types": "./dist/lint-staged.d.cts",
        "default": "./dist/lint-staged.cjs"
      }
    },
    "./prettier": {
      "import": {
        "types": "./dist/prettier.d.ts",
        "default": "./dist/prettier.js"
      },
      "require": {
        "types": "./dist/prettier.d.cts",
        "default": "./dist/prettier.cjs"
      }
    },
    "./semantic-release": {
      "import": {
        "types": "./dist/semantic-release.d.ts",
        "default": "./dist/semantic-release.js"
      },
      "require": {
        "types": "./dist/semantic-release.d.cts",
        "default": "./dist/semantic-release.cjs"
      }
    },
    "./package.json": "./package.json",
    "./tsconfig.json": "./tsconfig/tsconfig.base.json",
    "./tsconfig.base.json": "./tsconfig/tsconfig.base.json",
    "./tsconfig.browser.json": "./tsconfig/tsconfig.browser.json",
    "./tsconfig.decorators.json": "./tsconfig/tsconfig.decorators.json",
    "./tsconfig.lib.json": "./tsconfig/tsconfig.lib.json",
    "./tsconfig.node.json": "./tsconfig/tsconfig.node.json",
    "./tsconfig.react.json": "./tsconfig/tsconfig.react.json",
    "./tsconfig.strict.json": "./tsconfig/tsconfig.strict.json"
  },
  "files": [
    "dist/",
    "tsconfig/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "audit": "npm audit --omit=dev",
    "build": "tsup",
    "clean": "rimraf coverage dist",
    "check": "npx tsc --noEmit && npm run build && es-check es2022 'dist/*.cjs' && es-check es2022 --module 'dist/*.js'",
    "fix": "npx prettier --write . && npx eslint . --fix",
    "lint": "npx prettier --check . && npx eslint . --max-warnings 0",
    "prepare": "husky",
    "prebuild": "npm run clean && npm run lint",
    "pretest": "tsup",
    "test": "node --test 'test/*.test.js'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m14n/devkit.git"
  },
  "author": "Michael Krohmann",
  "funding": "https://github.com/sponsors/m14n",
  "bugs": {
    "url": "https://github.com/m14n/devkit/issues"
  },
  "homepage": "https://github.com/m14n/devkit",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@commitlint/config-conventional": ">=20 <22",
    "@eslint-react/eslint-plugin": ">=5 <6",
    "@eslint/js": ">=10 <11",
    "@typescript-eslint/eslint-plugin": ">=8 <9",
    "@typescript-eslint/parser": ">=8 <9",
    "commitlint": ">=20 <22",
    "eslint": ">=10 <11",
    "eslint-config-prettier": ">=10 <11",
    "eslint-plugin-import-x": ">=4.17 <5",
    "eslint-plugin-jsx-a11y-x": ">=0.2 <0.3",
    "eslint-plugin-react-hooks": ">=7 <8",
    "eslint-plugin-tsdoc": ">=0.5 <0.6",
    "globals": ">=13.24.0 <18",
    "prettier": ">=3 <4",
    "typescript": ">=5 <6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@swc/core": "1.16.21",
    "@types/node": "26.6.6",
    "commitlint": "21.2.4",
    "es-check": "9.8.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tsdoc": "^0.5.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli": "0.50.0",
    "rimraf": "6.1.4",
    "semantic-release": "25.0.9",
    "terser": "5.51.2",
    "tsup": "9.0.0"
  },
  "peerDependenciesMeta": {
    "@commitlint/config-conventional": {
      "optional": true
    },
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "commitlint": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y-x": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-tsdoc": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
